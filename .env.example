APP_ENV=development
APP_NAME=CEPHAS AI PowerOps
LOG_LEVEL=INFO

# Optional: one business-unit-scoped PostgreSQL login per service instance.
# Install requirements-postgres.txt before setting this value.
DATABASE_URL=

# OIDC access-token verification. Configure all three values together.
# Issuer and JWKS endpoint must use HTTPS outside localhost development.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
