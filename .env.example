APP_ENV=development
APP_NAME=CEPHAS AI PowerOps
LOG_LEVEL=INFO

# Optional: one business-unit-scoped PostgreSQL login per service instance.
# Install requirements-postgres.txt before setting this value.
DATABASE_URL=

# OIDC access-token verification. Install requirements-auth.txt and configure all three values together.
# Issuer and JWKS endpoint must use HTTPS outside localhost development.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Bounded PostgreSQL pool; each application instance must use one BU-scoped login.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8
DATABASE_POOL_TIMEOUT_SECONDS=5
